# Node Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_backend_db?schema=public

# Better Auth Configuration (Secret must be at least 32 characters in production)
BETTER_AUTH_SECRET=development_secret_key_at_least_32_chars_long_123456
BETTER_AUTH_URL=http://localhost:4000
