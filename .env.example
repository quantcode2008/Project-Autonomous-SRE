# SentinelAI Environment Variables Template
# Copy to .env and configure local secrets. Never commit .env to version control.

# ---- shared ----
NODE_ENV=development
DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinel
REDIS_URL=redis://localhost:6379/0
INTERNAL_SERVICE_TOKEN=change_me_32_bytes_random_hex_internal_token_here
ENCRYPTION_KEY=change_me_32_bytes_random_base64_encryption_key_here

# ---- web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# ---- api ----
PORT=4000
API_PORT=4000
BETTER_AUTH_SECRET=change_me_32_bytes_random_secret_for_better_auth_session
BETTER_AUTH_URL=http://localhost:4000
ENGINE_URL=http://127.0.0.1:8000

# ---- engine ----
ENGINE_PORT=8000
ENGINE_BIND=127.0.0.1
ENGINE_DATA_DIR=./engine_data
DEMO_REPO_PATH=./demo/checkout-service
ALLOWED_LOCAL_REPO_BASE=./demo

# ---- LLM ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- budgets and limits ----
BUDGET_MAX_TOKENS_PER_INCIDENT=500000
BUDGET_MAX_TOOL_CALLS_PER_AGENT_RUN=40
BUDGET_MAX_WALL_MINUTES=15
FIX_MAX_ATTEMPTS=4
CRITIC_MAX_ROUNDS=3
PATCH_MAX_FILES=5
PATCH_MAX_CHANGED_LINES=150
DEFAULT_DAILY_INVESTIGATIONS=5

# ---- sandbox ----
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_TIMEOUT_S=120
SANDBOX_TMPFS_MB=256
RUNNER_IMAGE=sentinel-runner:py312

# ---- optional delivery ----
GITHUB_TOKEN=
