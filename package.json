{
  "name": "sentinel-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev": "npm run dev:all",
    "dev:web": "npm run dev --workspace=@sentinel/web",
    "dev:api": "npm run dev --workspace=@sentinel/api",
    "dev:engine": "powershell -Command \"services/engine/.venv/Scripts/python -m uvicorn app.main:app --app-dir services/engine --host 127.0.0.1 --port 8000 --reload\"",
    "dev:worker": "powershell -Command \"$env:PYTHONPATH='services/engine'; services/engine/.venv/Scripts/celery -A app.worker.celery_app worker --pool=threads --concurrency=4 -l info\"",
    "dev:all": "concurrently -n \"web,api,engine,worker\" -c \"blue,green,magenta,yellow\" \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:engine\" \"npm run dev:worker\"",
    "test": "npm run test --workspaces --if-present && powershell -Command \"services/engine/.venv/Scripts/pytest services/engine/tests\"",
    "lint": "npm run lint --workspaces --if-present && powershell -Command \"services/engine/.venv/Scripts/ruff check services/engine\"",
    "demo:seed": "powershell -Command \"services/engine/.venv/Scripts/python scripts/seed_demo.py\"",
    "demo:traffic": "powershell -Command \"services/engine/.venv/Scripts/python demo/traffic/generate.py\"",
    "demo:inject": "powershell -Command \"services/engine/.venv/Scripts/python scripts/inject_bug.py\"",
    "demo:restore": "powershell -Command \"services/engine/.venv/Scripts/python scripts/restore.py\"",
    "eval": "powershell -Command \"services/engine/.venv/Scripts/python scripts/eval.py\"",
    "seed:admin": "npm run seed:admin -w apps/api --",
    "init:admin": "npm run init:admin -w apps/api --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0"
  }
}
